{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{js,css,map,ico,json,woff2}", "/media/*"]
  },
  "routes": [
    { "route": "/config.json", "headers": { "Cache-Control": "no-store" } },
    { "route": "/*.{js,css}", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer"
  }
}
