# Copy to .env (git-ignored) and fill in. Never commit real values.
# Passwords: 10+ characters using upper and lower case, digits and symbols.
# Use only these symbols: ! @ % _ - + .   (no $ ; & # quotes or spaces: these values are read by Docker Compose,
# by `source .env` in the README, and inside a connection string, and each treats those characters differently).
# The sa password is stored in the Docker volume on first start. To change it later run `docker compose down -v`
# (this deletes the local database).
MSSQL_SA_PASSWORD=
SQL_PORT=1433

# Only needed for the full stack in containers (`docker compose up --build`).
# JWT_SIGNING_KEY: at least 32 characters, e.g. from `openssl rand -base64 48`.
JWT_SIGNING_KEY=
# Shared password for the demo accounts the API container creates.
DEMO_USER_PASSWORD=

# Optional "Explain this fault" (see README). Ollama on this machine needs no key; leave AI_API_KEY empty.
AI_ENABLED=false
AI_API_KEY=
# Only for a provider other than the host's Ollama (defaults: http://host.docker.internal:11434/v1/ and phi4-mini).
# AI_BASE_URL=
# AI_MODEL=
